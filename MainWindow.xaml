<Window x:Class="DataBinding_TRPO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBinding_TRPO"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <!-- Первый столбик-->
        <Label Content="Зарплата" FontSize="24"/>

        <Label Content="Сотрудник" FontSize="18" Grid.Row="1"/>
        <Label Content="Оклад" FontSize="18" Grid.Row="2"/>
        <Label Content="Премия" FontSize="18" Grid.Row="3"/>
        <Label Content="Удержание" FontSize="18" Grid.Row="4"/>
        <Label Content="Сумма к выплате" FontSize="18" Grid.Row="5"/>

        <!--Второй столбик-->

        <TextBox Text="{Binding Name, Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Grid.Row="1" Grid.Column="1" TextChanged="TextBox_TextChanged"/>
        <TextBox Text="{Binding Salary, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Grid.Row="2" Grid.Column="1" TextChanged="TextBox_TextChanged"/>
        <TextBox Text="{Binding Bonus, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Grid.Row="3" Grid.Column="1" TextChanged="TextBox_TextChanged_1"/>
        <TextBox Text="{Binding Deduction, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Grid.Row="4" Grid.Column="1" TextChanged="TextBox_TextChanged_2"/>
        <TextBox Text="{Binding Payment, Mode=OneWay, UpdateSourceTrigger=LostFocus}" Grid.Row="5" Grid.Column="1" x:Name="PaymentBox"/>

    </Grid>
</Window>
